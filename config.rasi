/*
 * Catppuccin Mocha rofi theme
 * Place at ~/.config/rofi/config.rasi
 */

configuration {
    modi:                       "drun,window,run";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    font:                       "JetBrainsMono Nerd Font 11";
    display-drun:               " Apps";
    display-window:             " Windows";
    display-run:                " Run";
    drun-display-format:        "{name}";
    sidebar-mode:                false;
}

* {
    bg0:      #1e1e2e;  /* Base */
    bg1:      #313244;  /* Surface0 */
    bg2:      #45475a;  /* Surface1 */
    fg0:      #cdd6f4;  /* Text */
    fg1:      #a6adc8;  /* Subtext0 */
    accent:   #cba6f7;  /* Mauve */
    urgent:   #f38ba8;  /* Red */

    background-color:  transparent;
    text-color:         @fg0;
}

window {
    background-color:  @bg0;
    border:             2px;
    border-color:       @accent;
    border-radius:      8px;
    width:               600px;
    padding:             12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:   10px;
}

inputbar {
    background-color:  @bg1;
    text-color:          @fg0;
    border-radius:       6px;
    padding:             10px;
    children:            [ prompt, entry ];
}

prompt {
    text-color:  @accent;
    padding:      0px 8px 0px 0px;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @fg1;
}

listview {
    lines:               8;
    columns:              1;
    spacing:              4px;
    fixed-height:         false;
    scrollbar:            false;
}

element {
    padding:             8px;
    border-radius:       6px;
}

element normal.normal {
    background-color:  @bg0;
    text-color:          @fg0;
}

element selected.normal {
    background-color:  @bg2;
    text-color:          @accent;
}

element-text {
    background-color:  transparent;
    text-color:          inherit;
    vertical-align:      0.5;
}

element-icon {
    size:  20px;
}
